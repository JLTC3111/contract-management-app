# Copy to `.env` and fill in. `.env` is gitignored - never commit real values.
#
# Vite inlines every VITE_-prefixed variable that the browser source references
# into the client bundle, where anyone can read it. Only put values here under
# that prefix if they are safe to publish.

# --- shipped to the browser ---
# Project URL and anon key are public by design; the database is protected by
# Row Level Security, not by hiding these.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>

# Shared secret the sidebar's "Status updates" button sends to the
# contract-status-cron edge function. NOTE: this reaches the browser bundle, so
# treat it as public and rely on the function's own checks for real protection.
VITE_CRON_SECRET=<cron secret>

# --- server only, never VITE_-prefixed ---
# Bypasses Row Level Security entirely. Read by the Node maintenance scripts
# (check-contracts.js, manual-expire-contracts.js,
# trigger-contract-status-update.js, admin_password_reset/) and set separately
# as an edge-function secret via `supabase secrets set`.
SUPABASE_SERVICE_ROLE_KEY=<service role key>
