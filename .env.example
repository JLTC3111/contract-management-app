# Copy to `.env` and fill in. `.env` is gitignored - never commit real values.
#
# Vite inlines every VITE_-prefixed variable that the browser source references
# into the client bundle, where anyone can read it. Only put values here under
# that prefix if they are safe to publish.

# --- shipped to the browser ---
# Project URL and anon key are public by design; the database is protected by
# Row Level Security, not by hiding these.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>

# --- server only, never VITE_-prefixed ---
# Scheduled maintenance credential, configured as an Edge Function secret and
# in Supabase Vault. Manual status updates use the signed-in user's JWT instead.
CONTRACT_CRON_SECRET=<server cron secret>

# Bypasses Row Level Security entirely. Read by the Node maintenance scripts
# (check-contracts.js, manual-expire-contracts.js,
# trigger-contract-status-update.js, admin_password_reset/) and set separately
# as an edge-function secret via `supabase secrets set`.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Feedback delivery: reuse the password-reset SMTP account. Set these as Edge
# Function secrets; these values must never have the VITE_ prefix.
FEEDBACK_SMTP_HOST=<existing SMTP host>
FEEDBACK_SMTP_PORT=465
FEEDBACK_SMTP_USER=<existing SMTP username>
FEEDBACK_SMTP_PASSWORD=<existing SMTP password>
FEEDBACK_SMTP_FROM=<existing verified sender email>
