.DS_Store
**/.DS_Store

# Installed dependencies and generated output
node_modules/
# The repository already ships dist. Keep its entrypoint and hashed app bundles
# reviewable while ignoring other newly generated output.
dist/*
!dist/index.html
!dist/assets/
dist/assets/*
!dist/assets/index-*.js
!dist/assets/index-*.css

# Admin logs (contains sensitive information)
logs/
*.log

# Secrets. .env.example is the committed template.
.env
.env.*
!.env.example
